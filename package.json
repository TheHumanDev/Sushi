{
    "name": "sushi-language",
    "displayName": "Sushi Language Support",
    "description": "Language support for the Sushi programming language.",
    "icon": "Sushi.png",
    "publisher": "TheHumanDev",
    "version": "0.1.0",
    "repository": {
        "type": "git",
        "url": "git://github.com/TheHumanDev/Sushi"
    },
    "engines": {
        "vscode": "^1.138.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "files": [
        "client/out/**",
        "server/**",
        "syntaxes/*.tmLanguage.json",
        "*-language-configuration.json",
        "Sushi.png",
        "Susproj.png",
        "Susln.png",
        "README.md",
        "LICENSE"
    ],
    "main": "./client/out/extension",
    "contributes": {
        "languages": [
            {
                "id": "sushi",
                "aliases": [
                    "Sushi",
                    "sushi"
                ],
                "extensions": [
                    ".sus"
                ],
                "configuration": "./sushi-language-configuration.json",
                "icon": {
                    "light": "./Sushi.png",
                    "dark": "./Sushi.png"
                }
            },
            {
                "id": "susproj",
                "aliases": [
                    "Sushi Project",
                    "sushiproject"
                ],
                "extensions": [
                    ".susproj"
                ],
                "configuration": "./susproj-language-configuration.json",
                "icon": {
                    "light": "./Susproj.png",
                    "dark": "./Susproj.png"
                }
            },
            {
                "id": "susln",
                "aliases": [
                    "Sushi Solution",
                    "sushisolution"
                ],
                "extensions": [
                    ".susln"
                ],
                "configuration": "./susln-language-configuration.json",
                "icon": {
                    "light": "./Susln.png",
                    "dark": "./Susln.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "sushi",
                "scopeName": "source.sus",
                "path": "./syntaxes/sushi.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.sus": "sushi"
                }
            },
            {
                "language": "susproj",
                "scopeName": "source.susproj",
                "path": "./syntaxes/susproj.tmLanguage.json"
            },
            {
                "language": "susln",
                "scopeName": "source.susln",
                "path": "./syntaxes/susln.tmLanguage.json"
            },
            {
                "scopeName": "source.sushi.toml",
                "path": "./syntaxes/toml.tmLanguage.json"
            }
        ],
        "configurationDefaults": {
            "[sushi]": {
                "editor.semanticHighlighting.enabled": true,
                "editor.tabSize": 4,
                "editor.wordBasedSuggestions": "off"
            },
            "[susproj]": {
                "editor.semanticHighlighting.enabled": true,
                "editor.tabSize": 4
            },
            "[susln]": {
                "editor.semanticHighlighting.enabled": true,
                "editor.tabSize": 4
            }
        }
    },
    "activationEvents": [
        "workspaceContains:**/*.sus",
        "workspaceContains:**/*.susproj",
        "workspaceContains:**/*.susln"
    ],
    "scripts": {
        "check:manifest": "node -e \"const fs = require('node:fs'); const text = fs.readFileSync('package.json', 'utf8'); if (text.charCodeAt(0) === 0xFEFF) throw new Error('package.json must be UTF-8 without BOM'); JSON.parse(text);\"",
        "check-types": "tsc -p client/tsconfig.json --noEmit",
        "bundle": "esbuild client/src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=client/out/extension.js --sourcemap",
        "compile": "npm run check-types && npm run bundle",
        "precompile": "npm run check:manifest",
        "watch": "npm run bundle -- --watch",
        "generate:syntax": "js-yaml syntaxes/sushi.tmLanguage.yml > syntaxes/sushi.tmLanguage.json && js-yaml syntaxes/susln.tmLanguage.yml > syntaxes/susln.tmLanguage.json && js-yaml syntaxes/susproj.tmLanguage.yml > syntaxes/susproj.tmLanguage.json && js-yaml syntaxes/toml.tmLanguage.yml > syntaxes/toml.tmLanguage.json",
        "lint": "eslint .",
        "vscode:prepublish": "npm run compile && npm run generate:syntax",
        "package:vsix": "node scripts/package-vsix.mjs"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^22",
        "@types/vscode": "^1.138.0",
        "@vscode/vsce": "^4.1.1",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "js-yaml": "^5.4.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0"
    }
}
